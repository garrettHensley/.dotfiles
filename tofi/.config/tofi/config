# tofi — rivendell / lothlórien
# reference: man 5 tofi
# palette: twilight blue-black bg, parchment text, mallorn gold, mithril silver, mirkwood moss

#
### Fonts
#
	font = "EB Garamond Italic"
	font-size = 22
	font-features = "dlig, swsh, liga, kern"
	font-variations = "wght 500"
	hint-font = true

#
### Text theming
#
	# parchment
	text-color = #D8D1B8

	# prompt — mallorn gold (leaves of Lothlórien)
	prompt-color = #C9A86A
	prompt-background = #00000000
	prompt-background-padding = 0
	prompt-background-corner-radius = 0

	# placeholder — faded ink
	placeholder-color = #6E6A57
	placeholder-background = #00000000

	# input — bright parchment
	input-color = #EDE5CA
	input-background = #00000000

	# default result — mithril dim
	default-result-color = #A8A290
	default-result-background = #00000000
	default-result-background-padding = 4, 14

	# alternate result — faint stone zebra
	alternate-result-color = #A8A290
	alternate-result-background = #141A20
	alternate-result-background-padding = 4, 14
	alternate-result-background-corner-radius = 3

	# selection — mallorn gold leaf
	selection-color = #0E1319
	selection-background = #C9A86A
	selection-background-padding = 4, 14
	selection-background-corner-radius = 4

	# matching substring inside selection — inked deeper
	selection-match-color = #3A2F17

#
### Text cursor
#
	text-cursor = true
	text-cursor-style = bar
	text-cursor-color = #C9A86A
	text-cursor-thickness = 2
	text-cursor-corner-radius = 2

#
### Text layout
#
	prompt-text = "✦ "
	prompt-padding = 12
	placeholder-text = "speak, friend…"
	num-results = 8
	result-spacing = 6
	horizontal = false
	min-input-width = 0

#
### Window theming
#
	width = 520
	height = 420
	background-color = #0E1319

	outline-width = 0
	outline-color = #00000000

	border-width = 1
	border-color = #BFC6D0

	corner-radius = 6

	padding-top = 22
	padding-bottom = 22
	padding-left = 24
	padding-right = 24

	clip-to-padding = true
	scale = true

#
### Window positioning
#
	output = ""
	anchor = center
	exclusive-zone = -1
	margin-top = 0
	margin-bottom = 0
	margin-left = 0
	margin-right = 0

#
### Behaviour
#
	hide-cursor = true
	history = true
	matching-algorithm = fuzzy
	require-match = true
	auto-accept-single = false
	hide-input = false
	hidden-character = "*"
	physical-keybindings = true
	print-index = false
	drun-launch = true
	late-keyboard-init = false
	multi-instance = false
	ascii-input = false
